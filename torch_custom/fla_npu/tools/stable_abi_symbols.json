{
  "note": [
    "The runtime surface libfla_npu_stable.so is allowed to address, and the",
    "bounds it has to stay inside. tools/stable_abi_audit.py --lib checks a",
    "built launcher against this file; the vendored headers are pinned to",
    "torch 2.9 for the same reason (see the tree's README).",
    "",
    "Adding a symbol means the artifact now needs a torch that exports it:",
    "check it in min_torch before listing it here, otherwise the wheel quietly",
    "stops loading on the older runtimes the floor was chosen for."
  ],
  "min_torch": "2.7.1",
  "entry_symbol": "aoti_torch_library_impl",
  "forbidden_entry_symbols": ["torch_library_impl"],
  "allowed_torch_libraries": ["libtorch_cpu.so", "libc10.so", "libtorch.so"],
  "system_library_patterns": [
    "^libc\\.so\\.6$",
    "^libm\\.so\\.6$",
    "^libstdc\\+\\+\\.so\\.6$",
    "^libgcc_s\\.so\\.1$",
    "^ld-linux-.*\\.so\\..*$"
  ],
  "max_glibcxx": "3.4.21",
  "symbols": [
    "aoti_torch_delete_library_object",
    "aoti_torch_delete_tensor_object",
    "aoti_torch_dtype_bfloat16",
    "aoti_torch_dtype_bool",
