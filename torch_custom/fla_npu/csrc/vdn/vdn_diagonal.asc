#include "kernel_operator.h"
#include <acl/acl.h>
using namespace AscendC;

__aicore__ inline void Update(__gm__ float *src, __gm__ float *identity, int count)
{
    constexpr int D = 128;
    constexpr int W = 64;
    constexpr int sectors = D / W;
    TPipe pipe;
    TBuf<TPosition::VECCALC> buf;
    pipe.InitBuffer(buf, 2 * W * W * sizeof(float));
    auto x = buf.Get<float>();
    auto two = x[W * W];
    GlobalTensor<float> gm, eye;
    gm.SetGlobalBuffer(src);
    eye.SetGlobalBuffer(identity);
    DataCopyParams read{W, W / 8, (D - W) / 8, 0};
    DataCopyParams write{W, W / 8, 0, (D - W) / 8};
    DataCopy(two, eye, read);
    for (int job = GetBlockIdx(); job < count * sectors; job += GetBlockNum()) {
        int64_t off = int64_t(job / sectors) * D * D + (job % sectors) * W * (D + 1);
        DataCopy(x, gm[off], read);
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        Add(x, x, two, W * W);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopy(gm[off], x, write);
        PipeBarrier<PIPE_ALL>();
    }
}
__global__ __aicore__ void vdn_diagonal(__gm__ float *correction, __gm__ float *two, int count)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Update(correction, two, count);
}

extern "C" int launch_diagonal(float *correction, float *two, int count, int cores, aclrtStream stream)
{
    vdn_diagonal<<<cores, nullptr, stream>>>(correction, two, count);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

