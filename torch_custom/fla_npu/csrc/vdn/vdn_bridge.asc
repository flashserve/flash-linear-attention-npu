#include "kernel_operator.h"
#include <acl/acl.h>
using namespace AscendC;
template <class Out, int Rows>
__aicore__ inline void Gather(__gm__ float *pre, __gm__ float *suf, __gm__ int64_t *bounds, __gm__ float *sums,
                              __gm__ Out *dst, int start, int count, int heads, int frames, int64_t fs, int64_t cs)
{
    constexpr int D = 128;
    TPipe pipe;
    TBuf<TPosition::VECCALC> buf;
    pipe.InitBuffer(buf, (2 * Rows * D + 4 * D) * sizeof(float) + Rows * D * sizeof(Out));
    auto p = buf.Get<float>();
    auto s = p[Rows * D];
    auto lo = p[2 * Rows * D];
    auto hi = lo[D];
    auto left = hi[D];
    auto right = left[D];
    auto converted = right[D].template ReinterpretCast<Out>();
    GlobalTensor<float> pg, sg, lg;
    GlobalTensor<Out> yg;
    GlobalTensor<int64_t> indices;
    pg.SetGlobalBuffer(pre);
    sg.SetGlobalBuffer(suf);
    lg.SetGlobalBuffer(sums);
    yg.SetGlobalBuffer(dst);
    indices.SetGlobalBuffer(bounds);
    const int64_t matrix_stride = (int64_t)heads * D * D;
    BinaryRepeatParams broadcast{1, 1, 1, 16, 16, 0};
    for (int job = GetBlockIdx(); job < count * heads; job += GetBlockNum()) {
        int f = start + job / heads;
        int h = job % heads;
        int64_t a = indices.GetValue(f * fs);
        int64_t hi_frame = indices.GetValue(f * fs + cs);
        // The public path checks CPU bounds. Clamp here as well for direct dispatcher calls.
        a = a < 0 ? 0 : (a > f ? f : a);
        int64_t z = (hi_frame < f ? f : (hi_frame >= frames ? frames - 1 : hi_frame)) + 1;
        DataCopy(lo, lg[(a * heads + h) * D], D);
        DataCopy(hi, lg[(z * heads + h) * D], D);
        DataCopy(left, lg[((int64_t(f) + 1) * heads + h) * D], D);
        DataCopy(right, lg[(int64_t(f) * heads + h) * D], D);
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        Sub(left, left, lo, D);
        Sub(right, hi, right, D);
        PipeBarrier<PIPE_V>();
        Exp(left, left, D);
        Exp(right, right, D);
        PipeBarrier<PIPE_V>();
        for (int r = 0; r < D; r += Rows) {
            int64_t off = int64_t(h) * D * D + r * D;
            DataCopy(p, pg[a * matrix_stride + off], Rows * D);
            DataCopy(s, sg[z * matrix_stride + off], Rows * D);
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);
            for (int i = 0; i < 2; ++i) {
                Mul(p[i * 64], p[i * 64], left[i * 64], 64, Rows, broadcast);
                Mul(s[i * 64], s[i * 64], right[i * 64], 64, Rows, broadcast);
            }
            PipeBarrier<PIPE_V>();
            Add(p, p, s, Rows * D);
            if constexpr (!std::is_same_v<Out, float>) {
                PipeBarrier<PIPE_V>();
                Cast(converted, p, RoundMode::CAST_RINT, Rows * D);
            }
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            if constexpr (std::is_same_v<Out, float>)
                DataCopy(yg[(int64_t)job * D * D + r * D], p, Rows * D);
            else
                DataCopy(yg[(int64_t)job * D * D + r * D], converted, Rows * D);
            PipeBarrier<PIPE_ALL>();
        }
    }
}
__global__ __aicore__ void bridge_kernel(__gm__ float *p, __gm__ float *s, __gm__ int64_t *bounds, __gm__ float *logs,
                                         __gm__ uint8_t *out, int start, int count, int h, int frames, int64_t fs,
                                         int64_t cs, int bf)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    if (bf) {
        Gather<bfloat16_t, 64>(p, s, bounds, logs, (__gm__ bfloat16_t *)out, start, count, h, frames, fs, cs);
    } else {
        Gather<float, 64>(p, s, bounds, logs, (__gm__ float *)out, start, count, h, frames, fs, cs);
    }
}
extern "C" int launch_bridge(float *p, float *s, int64_t *bounds, float *logs, void *out, int start, int count, int h,
                             int frames, int64_t fs, int64_t cs, int bf, int cores, aclrtStream stream)
{
    // This thread may already have a handled runtime error from an unrelated API.
    // Consume it before launch so the following read refers to this submission.
    (void)aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    bridge_kernel<<<cores, nullptr, stream>>>(p, s, bounds, logs, (uint8_t *)out, start, count, h, frames, fs, cs, bf);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

