#include "kernel_operator.h"
#include <acl/acl.h>
#if defined(__DAV_C220_CUBE__)
#define MEMORY_BASE
#include <pto/pto-inst.hpp>
using namespace pto;
constexpr int D = 128;
using Matrix = GlobalTensor<float, Shape<1, 1, 1, D, D>, Stride<D * D, D * D, D * D, D, 1>, Layout::ND>;
using L1Matrix = Tile<TileType::Mat, float, D, D, BLayout::ColMajor, D, D, SLayout::RowMajor>;
#endif

// A job owns all rows for one head and one direction, including every update
// to its destination. The host prefills each destination with its injection.
__global__ __aicore__ void vdn_scan(__gm__ float *transition, __gm__ float *prefix, __gm__ float *suffix, int frames,
                                    int heads)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
#if defined(__DAV_C220_CUBE__)
    AscendC::SetHF32Mode(false);
    L1Matrix state, matrix;
    TileLeft<float, D, D> lhs;
    TileRight<float, D, D> rhs;
    TileAcc<float, D, D> product;
    TASSIGN(state, 0);
    TASSIGN(matrix, D * D * sizeof(float));
    TASSIGN(lhs, 0);
    TASSIGN(rhs, 0);
    TASSIGN(product, 0);
    const int64_t stride = int64_t(heads) * D * D;
    for (int job = AscendC::GetBlockIdx(); job < 2 * heads; job += AscendC::GetBlockNum()) {
        const bool reverse = job >= heads;
        const int64_t offset = int64_t(job % heads) * D * D;
        auto bank = reverse ? suffix : prefix;
        for (int i = 0; i < frames; ++i) {
            const int f = reverse ? frames - 1 - i : i;
            Matrix src(bank + (f + int(reverse)) * stride + offset);
            Matrix mat(transition + f * stride + offset);
            Matrix dst(bank + (f + 1 - int(reverse)) * stride + offset);
            TLOAD(matrix, mat);
            TLOAD(state, src);
            pipe_barrier(PIPE_ALL);
            TMOV(lhs, state);
            TMOV(rhs, matrix);
            pipe_barrier(PIPE_ALL);
            TMATMUL(product, lhs, rhs);
            pipe_barrier(PIPE_ALL);
            AscendC::SetAtomicAdd<float>();
            TSTORE(dst, product);
            pipe_barrier(PIPE_ALL);
            AscendC::SetAtomicNone();
            pipe_barrier(PIPE_ALL);
        }
    }
#endif
}

extern "C" int launch_scan(float *transition, float *prefix, float *suffix, int frames, int heads, int cores,
                           aclrtStream stream)
{
    // This thread may already have a handled runtime error from an unrelated API.
    // Consume it before launch so the following read refers to this submission.
    (void)aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    vdn_scan<<<cores, nullptr, stream>>>(transition, prefix, suffix, frames, heads);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

