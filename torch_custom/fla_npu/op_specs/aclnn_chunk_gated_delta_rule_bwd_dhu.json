  "helpers": "inline int64_t bwd_dhu_chunk_count(const std::vector<int64_t>& chunk_indices, int64_t chunk_size, int64_t total_tokens) {\n  if (!chunk_indices.empty()) {\n    return static_cast<int64_t>(chunk_indices.size()) / 2;\n  }\n  return (total_tokens + chunk_size - 1) / chunk_size;\n}",
