{
  "schema_version": 1,
  "op": "fused_recurrent_rwkv8",
  "implementation": "ascendc",
  "model": "rwkv8",
  "symbol_table_version": "rwkv8-shape-v1",
  "upstream_alignment": {
    "semantics": {
      "repository": "BlinkDL/RWKV-LM",
      "commit": "9521024",
      "source": "RWKV-v8/cuda/wkv7_cuda.cu forward_kernel (lines 10-52)",
      "note": "z/b 参数化口径：z = -kk, b = kk * a_inctx，decay = exp(-exp(w))"
    },
    "precision_peer": {
      "repository": "fla-org/flash-linear-attention",
      "commit": "a4a2624b",
      "source": "fla/ops/generalized_delta_rule/dplr (fused_recurrent 前向)",
      "note": "fla state 与 RWKV 朝向互为转置；gk = -exp(w)"
    }
  },
  "capability": {
    "soc": [
      "ascend910b"
    ],
    "dtypes": [
      "float32"
    ],
    "state_dtypes": [
      "float32"
    ],
    "layouts": [
      "BHTN"
    ],
    "features": [
      "逐 token 递推前向（fused recurrent，推理路径）",
      "可选初始状态（RWKV 朝向 (B,H,N,N)，fp32）",
      "scale 作用于 q 读出",
      "无 T % 16 约束（区别于官方 CUDA kernel）",
      "chunk_len 属性控制 s 快照间隔（默认 16 对齐官方 backward；非 16 值与官方 backward 不兼容）"
    ],
    "routes": [
      "ascendc",
      "direct_launch"
    ]
  },
  "data_generation": {
    "floating_inputs": {
      "distribution": "normal",
      "note": "q/k/v ~ randn；w = -rand*2-0.1（log 域衰减参数，保证 decay ∈ (0,1)）"
    },
    "structured_inputs": "z = -kk, b = kk * a，kk 为 L2 归一化向量；禁止无约束 randn 造 z/b（delta-rule 状态会指数爆炸）"
  },
  "tolerance": {
    "float32": {
      "rel_rmse": 0.002
    },
    "note": "golden vs 官方 GPU CUDA fixture 用 fla fwd 口径 rel-RMSE <= 0.002（实测 ~1e-7）；kernel vs golden 项目口径 rtol=atol 5e-3，当前实测 ~1e-7"
  },
  "coverage_requirements": {
    "public_modes": [
      "可选初始状态",
      "scale = 1.0 / 1/sqrt(N)",
      "T = 1（decode）与长序列",
      "T 非 16 倍数"
    ],
    "known_limits": [
      "当前实现 fp32 only，bf16 输入路径待补",
      "K <= 128（K 维不切分，K×V 的 state 须整体放入单核 UB）",
      "V <= 128（V 维不切分，K×V state 须整体放入单核 UB）",
      "仅前向；反向归 chunk 算子另行立项"
    ]
  },
  "cases": [
    {
      "id": "fused_recurrent_rwkv8_main_accuracy",
      "tags": ["accuracy", "example", "route"],
      "shape": {"B": 2, "T": 64, "H": 4, "N": 64},
      "dtype": {"q_w_k_v_z_b": "float32", "state": "float32"},
      "layout": "BHTN",
      "attrs": {"scale": 1.0},
      "optional_inputs": {"initial_state": null},
      "soc": ["ascend910b"],
      "run_on": ["ascendc", "direct_launch"],
      "reference": "tests/reference/fused_recurrent_rwkv8_reference.py",
      "expect": {
        "return_code": "ACLNN_SUCCESS",
        "finite_outputs": true,
        "compare_outputs": ["o"]
      },
      "seed": 42
    },
    {
      "id": "fused_recurrent_rwkv8_init_and_scale",
