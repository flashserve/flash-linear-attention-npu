      "shape": {"B": 1, "T": 16, "H": 2, "N": 64},
      "dtype": {"q_w_k_v_z_b": "float32", "state": "float32"},
      "layout": "BHTN",
      "attrs": {"scale": 0.125},
      "optional_inputs": {"initial_state": "present"},
      "soc": ["ascend910b"],
      "run_on": ["ascendc", "direct_launch"],
      "reference": "tests/reference/fused_recurrent_rwkv8_reference.py",
