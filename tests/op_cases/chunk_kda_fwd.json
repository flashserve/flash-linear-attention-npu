{
  "schema_version": 1,
  "op": "chunk_kda_fwd",
  "implementation": "ascendc",
  "model": "kda",
  "symbol_table_version": "kda-shape-v1",
  "upstream_alignment": {
    "repository": "fla-org/flash-linear-attention",
    "commit": "0f0f0c97af39343855b43bbbaddcedfda5cb9d77",
    "source": "fla/ops/kda/chunk_fwd.py",
    "scope": "non-CP low-level chunk_kda_fwd 12-value return policy",
    "return_policy": {
      "final_state": "output_final_state",
      "gk": "not use_gate_in_kernel or disable_recompute",
      "w_u_qg_kg_v_new": "disable_recompute",
      "h": "disable_recompute or return_intermediate_states"
    }
  },
  "capability": {
    "soc": [
      "ascend910b",
      "ascend910_93",
      "ascend950"
    ],
    "dtypes": [
      "bfloat16",
      "float16"
    ],
    "gate_beta_dtypes": [
      "bfloat16",
      "float32"
    ],
    "state_dtypes": [
      "float32"
    ],
    "layouts": [
      "BNSD",
      "BSND",
      "NTD",
      "TND"
    ],
    "features": [
      "定长/变长序列",
      "四种显式 layout",
      "可选初始/最终状态",
      "FLA 重计算输出策略",
      "raw gate 和已激活 gate",
      "safe_gate true/false",
      "state_v_first true/false"
    ],
    "routes": [
      "ascendc",
      "aclnn",
      "direct_launch"
    ],
    "optional_routes": [
      "torch_ops_npu"
    ]
  },
  "data_generation": {
    "floating_inputs": {
      "distribution": "uniform",
      "min": -1.0,
      "max": 1.0
    },
    "positive_inputs": {
      "distribution": "uniform",
      "min": 0.0,
      "max": 1.0
    },
    "structured_inputs": "由 reference 名称对应的 runner 构造 gate、三角矩阵、状态和索引"
  },
  "coverage_requirements": {
    "public_modes": [
      "定长/变长序列",
      "四种显式 layout",
      "可选初始/最终状态",
      "可选中间量"
    ],
    "known_limits": [
      "chunk_size 仅支持 64/128；K/V 均须在 [16,256] 且为 16 的倍数；交付矩阵覆盖 K=128、V=128/256。",
      "H_k/H_v 必须在 [1,128] 且 H_v % H_k == 0；TND/NTD 均支持多 head。",
      "变长序列的 cu_seqlens 至少含首尾、非递减且末项等于 T；单次最多 1024 条逻辑序列。",
      "显式 chunk_indices 必须完整、合法并严格采用 sequence-major 规范顺序。",
      "use_gate_in_kernel=true 时内部计算 -exp(A_log)*softplus(g+dt_bias) 或 lower_bound*sigmoid(exp(A_log)*(g+dt_bias))；false 时 g 为已激活的自然对数门控。",
      "attn_out 固定为 BSND/TND，final_state 与公开 h 为 sequence-major；其余反向中间量固定为 BNSD/NTD，state_v_first 只交换 state/h 的末两维。"
    ],
    "required_outputs": [
      "attn_out",
      "Aqk/Akk",
      "按属性可选的 final_state/gk/w/u/qg/kg/v_new/h",
      "Python initial_state 透传"
    ],
