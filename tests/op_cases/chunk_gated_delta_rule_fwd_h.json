{
  "schema_version": 1,
  "operator": "chunk_gated_delta_rule_fwd_h",
  "interface_contract": {
    "gate_modes": {
      "gdn_v1": {
        "g": "required",
        "gk": null,
        "stage1": "v_new_decay = gate(g_last - g) * v_new",
        "stage2": "delta_h = raw_k^T @ v_new_decay"
      },
      "kda_gdn2": {
        "g": null,
        "gk": "required",
        "stage1": "v_new is forwarded without an extra decay",
        "stage2": "delta_h = kg^T @ v_new"
      }
    },
    "negative_gate_cases": [
      {
        "id": "missing_g_and_gk",
        "has_g": false,
        "has_gk": false,
        "expected_return_code": "ACLNN_ERR_PARAM_INVALID"
      },
      {
        "id": "both_g_and_gk",
        "has_g": true,
        "has_gk": true,
        "expected_return_code": "ACLNN_ERR_PARAM_INVALID"
      }
    ],
    "mode_selector": "presence of g/gk only; use_exp2 and state_v_first are orthogonal"
  },
  "stage0_debug": {
    "chunk_size": 64,
    "k_dim": 128,
    "v_dim": 128,
    "dtypes": ["bfloat16", "float16"],
    "input_kinds": ["coordinate", "random"],
    "max_abs_tolerance": 1e-6,
    "relative_l2_tolerance": 1e-6,
    "positive_cases": [
      {
        "id": "dense_full",
        "layout": "dense",
        "batch": 1,
        "num_heads": 4,
        "total_tokens": 64
      },
      {
        "id": "dense_tail_min",
        "layout": "dense",
        "batch": 1,
        "num_heads": 4,
        "total_tokens": 16
      },
      {
        "id": "dense_tail",
        "layout": "dense",
        "batch": 1,
        "num_heads": 4,
        "total_tokens": 37
      },
      {
        "id": "dense_multiwave_multichunk",
        "layout": "dense",
        "batch": 3,
        "num_heads": 16,
        "total_tokens": 128
      },
      {
        "id": "varlen_full_and_tail",
        "layout": "varlen",
        "batch": 1,
        "num_heads": 4,
        "cu_seqlens": [0, 37, 118]
      }
    ],
    "production_only_cases": [
      {
        "id": "dense_short_tail_multiwave",
        "layout": "dense",
        "batch": 3,
        "num_heads": 16,
        "total_tokens": 15
      },
      {
        "id": "varlen_full_and_short_tails",
        "layout": "varlen",
        "batch": 1,
        "num_heads": 16,
        "cu_seqlens": [0, 15, 94]
      }
    ],
    "production_cases": [
      "dense_full",
      "dense_tail",
      "dense_multiwave_multichunk",
      "dense_short_tail_multiwave",
      "varlen_full_and_short_tails"
    ],
    "short_tail_case": {
      "id": "dense_short_tail",
      "layout": "dense",
      "batch": 1,
      "num_heads": 1,
      "total_tokens": 15,
      "expected_debug_error": "only covers the Cube path"
    }
  }
}
