        "B": 1,
        "HK": 4,
        "HV": 4,
        "T": 128,
        "K": 128,
        "V": 128,
        "chunk_size": 64,
        "use_exp2": false,
        "output_final_state": true,
        "expected_gate": "exp(gk)"
      },
      {
