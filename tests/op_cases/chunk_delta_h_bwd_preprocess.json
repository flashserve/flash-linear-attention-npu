  "negative_cases": [
    {
      "id": "neg_01_g_and_gk_both",
      "note": "g 与 gk 同时非空：必须拦截（GVA 路径下二者互斥）",
      "expected_return_code": "ACLNN_ERR_PARAM_INVALID",
      "trigger": "host tiling：hasG && hasGk"
    },
    {
      "id": "neg_02_k_too_large",
      "note": "K=512 超过 4 个 64 行组的上限",
      "expected_return_code": "ACLNN_ERR_PARAM_INVALID",
      "trigger": "host tiling：K > 256"
    },
    {
      "id": "neg_03_hv_not_multiple_of_hk",
      "note": "Hk=3 Hv=4：GVA 映射不成立",
      "expected_return_code": "ACLNN_ERR_PARAM_INVALID",
      "trigger": "host tiling：Hv % Hk != 0"
    },
    {
      "id": "neg_04_dense_b_greater_than_one",
      "note": "未传 cu_seqlens 且 B=2：一次 launch 只处理一个 segment",
      "expected_return_code": "ACLNN_ERR_PARAM_INVALID",
      "trigger": "host tiling：dense 路径要求 B == 1"
    },
    {
      "id": "neg_05_varlen_b_greater_than_one",
      "note": "传 cu_seqlens 且 B=2：packed 输入必须 B==1",
      "expected_return_code": "ACLNN_ERR_PARAM_INVALID",
      "trigger": "host tiling：varlen 路径要求 B == 1"
    },
    {
      "id": "neg_06_chunk_size_not_64",
      "note": "chunk_size=128 与本版 tiling 不匹配",
      "expected_return_code": "ACLNN_ERR_PARAM_INVALID",
      "trigger": "host tiling：chunk_size != 64"
    },
    {
      "id": "neg_07_g_shape_mismatch",
      "note": "g 为 [B,Hk,T] 而非 [B,Hv,T]",
      "expected_return_code": "ACLNN_ERR_PARAM_INVALID",
      "trigger": "host tiling：g shape != [B,Hv,T]"
    },
    {
      "id": "neg_08_gk_dtype_fp32",
      "note": "gk 为 FP32：逐 K gate 必须与 q/k 同 dtype",
      "expected_return_code": "ACLNN_ERR_PARAM_INVALID",
      "trigger": "host tiling：gk dtype != q dtype"
    },
    {
      "id": "neg_09_cu_seqlens_too_short",
      "note": "cu_seqlens 只有 1 个元素，无法给出 [bos, eos)",
      "expected_return_code": "ACLNN_ERR_PARAM_INVALID",
      "trigger": "host tiling：cu_seqlens shape dim0 - 1 < 1"
    },
    {
      "id": "neg_10_empty_tensor",
      "note": "T=0：空 tensor 必须给出明确错误",
      "expected_return_code": "ACLNN_ERR_PARAM_INVALID",
      "trigger": "host tiling：B/T/Hk/Hv/K/V 存在 0"
    }
  ]
