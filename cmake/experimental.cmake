# Experimental inputs form a closed tree. Keep these checks independent of CANN
# so the discovery and dependency contract can be tested with plain CMake.
include_guard(GLOBAL)

function(fla_check_operator_build_mode)
    if(ENABLE_EXPERIMENTAL)
        if(NOT BUILD_OPEN_PROJECT OR BUILD_OPS_RTY_KERNEL OR ENABLE_BUILT_IN OR ENABLE_STATIC)
            message(FATAL_ERROR
                "Experimental builds currently support only custom OPP packages: "
                "BUILD_OPEN_PROJECT=ON, BUILD_OPS_RTY_KERNEL=OFF, ENABLE_BUILT_IN=OFF, ENABLE_STATIC=OFF.")
        endif()
        set(_mode experimental)
    else()
        set(_mode stable)
    endif()
    if(DEFINED FLA_CONFIGURED_OPERATOR_MODE AND
       NOT "${FLA_CONFIGURED_OPERATOR_MODE}" STREQUAL "${_mode}")
        message(FATAL_ERROR
            "Cannot reuse a ${FLA_CONFIGURED_OPERATOR_MODE} build directory for ${_mode} operators. "
            "Use a new build directory or remove the previous build directory first.")
    endif()
    set(FLA_CONFIGURED_OPERATOR_MODE "${_mode}" CACHE INTERNAL "Operator source tree" FORCE)
endfunction()

function(fla_assert_experimental_name name)
    if(NOT "${name}" MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*$" OR
       "${name}" MATCHES "^(all|ALL|scripts|tests|cmake|torch_custom|docs)$")
        message(FATAL_ERROR "Invalid experimental operator name '${name}'.")
    endif()
endfunction()

function(fla_assert_path_within path root context)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "${context}: missing path '${path}'.")
    endif()
    get_filename_component(_real_path "${path}" REALPATH)
    get_filename_component(_real_root "${root}" REALPATH)
    file(RELATIVE_PATH _relative "${_real_root}" "${_real_path}")
    if(IS_ABSOLUTE "${_relative}" OR "${_relative}" MATCHES "^\\.\\.(/|$)")
        message(FATAL_ERROR
            "${context}: path '${path}' resolves outside '${_real_root}': '${_real_path}'.")
    endif()
endfunction()

function(fla_validate_experimental_tree path root ancestors)
    fla_assert_path_within("${path}" "${root}" "Experimental source isolation")
    if(IS_DIRECTORY "${path}")
        get_filename_component(_real_path "${path}" REALPATH)
        if("${_real_path}" IN_LIST ancestors)
            message(FATAL_ERROR "Experimental source tree contains a directory link cycle: '${path}'.")
        endif()
        list(APPEND ancestors "${_real_path}")
        file(GLOB _children LIST_DIRECTORIES true "${path}/*")
        foreach(_child IN LISTS _children)
            fla_validate_experimental_tree("${_child}" "${root}" "${ancestors}")
        endforeach()
    endif()
endfunction()

function(fla_experimental_root out_var)
    set(_root "${CMAKE_SOURCE_DIR}/experimental")
    fla_assert_path_within("${_root}" "${CMAKE_SOURCE_DIR}" "Experimental root isolation")
    # A symlink alias of the stable tree inside the repository is also invalid.
    get_filename_component(_actual "${_root}" REALPATH)
    get_filename_component(_source "${CMAKE_SOURCE_DIR}" REALPATH)
    if(NOT "${_actual}" STREQUAL "${_source}/experimental")
        message(FATAL_ERROR "Experimental root must resolve to '${_source}/experimental', got '${_actual}'.")
    endif()
    set(${out_var} "${_root}" PARENT_SCOPE)
endfunction()

function(fla_experimental_ops_root out_var)
    fla_experimental_root(_root)
    set(_ops "${_root}/ops")
    fla_assert_path_within("${_ops}" "${_root}" "Experimental ops root isolation")
    get_filename_component(_actual "${_ops}" REALPATH)
    get_filename_component(_expected "${_root}" REALPATH)
    if(NOT "${_actual}" STREQUAL "${_expected}/ops")
        message(FATAL_ERROR "Experimental ops root must resolve to '${_expected}/ops', got '${_actual}'.")
    endif()
    set(${out_var} "${_ops}" PARENT_SCOPE)
endfunction()

function(fla_validate_experimental_operator name out_var)
    fla_assert_experimental_name("${name}")
    fla_experimental_root(_root)
    fla_experimental_ops_root(_ops)
    set(_operator "${_ops}/${name}")
    if(NOT EXISTS "${_operator}/CMakeLists.txt" OR IS_DIRECTORY "${_operator}/CMakeLists.txt")
        message(FATAL_ERROR
            "Experimental dependency/operator is missing: '${name}', expected '${_operator}/CMakeLists.txt'.")
    endif()
    fla_validate_experimental_tree("${_operator}" "${_root}" "")
    set(${out_var} "${_operator}" PARENT_SCOPE)
endfunction()

function(fla_validate_experimental_common out_var)
    fla_experimental_root(_root)
    set(_common "${_root}/_common")
    if(NOT IS_DIRECTORY "${_common}")
        message(FATAL_ERROR "Experimental common directory is missing: '${_common}'.")
    endif()
    fla_assert_path_within("${_common}" "${_root}" "Experimental common isolation")
    fla_validate_experimental_tree("${_common}" "${_common}" "")
    set(_manifest "${_common}/manifest.txt")
    if(NOT EXISTS "${_manifest}" OR IS_DIRECTORY "${_manifest}")
        message(FATAL_ERROR "Experimental common manifest is missing: '${_manifest}'.")
    endif()
    # This is a required-file list, not an allowlist. Empty/comment-only means
    # no required files; all files that are present still receive path checks.
    file(STRINGS "${_manifest}" _required_files)
    foreach(_file IN LISTS _required_files)
        string(STRIP "${_file}" _file)
        if("${_file}" STREQUAL "" OR "${_file}" MATCHES "^[#;]")
            continue()
        endif()
        if(NOT "${_file}" MATCHES "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$" OR
           "${_file}" MATCHES "(^|/)\\.\\.?(/|$)")
            message(FATAL_ERROR "Experimental common manifest contains an invalid path: '${_file}'.")
        endif()
        fla_assert_path_within("${_common}/${_file}" "${_common}" "Experimental common required file")
        if(IS_DIRECTORY "${_common}/${_file}")
            message(FATAL_ERROR "Experimental common manifest requires a file, got directory '${_file}'.")
        endif()
    endforeach()
    get_filename_component(_common "${_common}" REALPATH)
    set(${out_var} "${_common}" PARENT_SCOPE)
endfunction()

function(_fla_visit_experimental_dependency op stack)
    if("${op}" IN_LIST stack)
        list(APPEND stack "${op}")
        string(REPLACE ";" " -> " _chain "${stack}")
        message(FATAL_ERROR "Experimental dependency cycle: ${_chain}")
    endif()
    get_property(_done GLOBAL PROPERTY "FLA_EXPERIMENTAL_VISITED_${op}")
    if(_done)
        return()
    endif()
    list(APPEND stack "${op}")
    foreach(_dependency IN LISTS ${op}_depends)
        _fla_visit_experimental_dependency("${_dependency}" "${stack}")
    endforeach()
    set_property(GLOBAL PROPERTY "FLA_EXPERIMENTAL_VISITED_${op}" TRUE)
endfunction()

function(fla_validate_experimental_dependency_graph)
    foreach(_op IN LISTS ARGN)
        set_property(GLOBAL PROPERTY "FLA_EXPERIMENTAL_VISITED_${_op}" FALSE)
    endforeach()
    foreach(_op IN LISTS ARGN)
        _fla_visit_experimental_dependency("${_op}" "")
    endforeach()
endfunction()

# Called after the selected roots have been mounted. A macro intentionally keeps
# add_subdirectory and dependency declarations in the caller's directory scope.
macro(fla_expand_experimental_dependencies op_list op_dir_list)
    set(_fla_frontier ${${op_list}})
    foreach(_fla_op IN LISTS _fla_frontier)
        set_property(GLOBAL PROPERTY "FLA_EXPERIMENTAL_CHAIN_${_fla_op}" "${_fla_op}")
    endforeach()
    list(LENGTH _fla_frontier _fla_frontier_size)
    while(_fla_frontier_size GREATER 0)
        op_add_depend_directory(OP_LIST ${_fla_frontier} OP_DIR_LIST _fla_dependencies)
        set(_fla_next)
        foreach(_fla_dir IN LISTS _fla_dependencies)
            get_filename_component(_fla_name "${_fla_dir}" NAME)
            if("${_fla_name}" IN_LIST ${op_list})
                continue()
            endif()
            list(APPEND ${op_list} "${_fla_name}")
            list(APPEND ASCEND_OP_NAME "${_fla_name}")
            list(APPEND ${op_dir_list} "${_fla_dir}")
            add_subdirectory("${_fla_dir}")
            list(APPEND _fla_next "${_fla_name}")
        endforeach()
        set(_fla_frontier ${_fla_next})
        list(LENGTH _fla_frontier _fla_frontier_size)
    endwhile()
    list(REMOVE_DUPLICATES ${op_list})
    list(REMOVE_DUPLICATES ${op_dir_list})
    fla_validate_experimental_dependency_graph(${${op_list}})
endmacro()

function(_fla_audit_experimental_input value target source_dir property)
    # Preserve generator expressions for the textual check. A literal stable
    # source path inside one is still an explicit cross-tree build input.
    string(REPLACE "\\" "/" _path "${value}")
    if("${_path}" MATCHES "(^|/)fla/ops/ascendc(/|>|$)")
        message(FATAL_ERROR
            "Experimental target '${target}' references the stable operator tree in ${property}: '${value}'.")
    endif()
    # Resolve ordinary paths and simple build-interface expressions, including
    # symlinks located outside the operator directory. Generated paths that do
    # not exist yet remain valid; this is an input audit, not a CMake sandbox.
    string(REGEX REPLACE "^\\$<BUILD_INTERFACE:(.*)>$" "\\1" _path "${_path}")
    if(NOT "${_path}" MATCHES "\\$<")
        get_filename_component(_absolute "${_path}" ABSOLUTE BASE_DIR "${source_dir}")
        if(EXISTS "${_absolute}")
            get_filename_component(_real "${_absolute}" REALPATH)
            if("${_real}" MATCHES "(^|/)fla/ops/ascendc(/|$)")
                message(FATAL_ERROR
                    "Experimental target '${target}' resolves to the stable operator tree in ${property}: '${value}' -> '${_real}'.")
            endif()
        endif()
    endif()
endfunction()

function(fla_audit_experimental_targets directory)
    get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(_target IN LISTS _targets)
        get_target_property(_type "${_target}" TYPE)
        set(_properties SOURCES INCLUDE_DIRECTORIES INTERFACE_SOURCES INTERFACE_INCLUDE_DIRECTORIES)
        if(_type STREQUAL "INTERFACE_LIBRARY" AND CMAKE_VERSION VERSION_LESS "3.19")
            # Older CMake restricts interface targets to a property whitelist.
            # BUILDSYSTEM_TARGETS already identifies their owning directory.
            set(_source_dir "${directory}")
            set(_properties INTERFACE_SOURCES INTERFACE_INCLUDE_DIRECTORIES)
        else()
            get_target_property(_source_dir "${_target}" SOURCE_DIR)
        endif()
        foreach(_property IN LISTS _properties)
            get_target_property(_values "${_target}" "${_property}")
            if(NOT "${_values}" STREQUAL "_values-NOTFOUND")
                foreach(_value IN LISTS _values)
                    _fla_audit_experimental_input("${_value}" "${_target}" "${_source_dir}" "${_property}")
                endforeach()
            endif()
        endforeach()
    endforeach()
    get_property(_subdirectories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_subdirectory IN LISTS _subdirectories)
        fla_audit_experimental_targets("${_subdirectory}")
    endforeach()
endfunction()

function(fla_write_experimental_ops filename)
    set(_ops ${ARGN})
    list(REMOVE_DUPLICATES _ops)
    list(SORT _ops)
    string(REPLACE ";" "\n" _text "${_ops}")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${filename}" "${_text}\n")
endfunction()
