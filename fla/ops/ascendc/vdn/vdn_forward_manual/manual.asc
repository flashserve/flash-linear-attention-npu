#include "kernel_operator.h"
#include "../vdn_scan/op_kernel/arch22/vdn_scan_cube.h"
#include <acl/acl.h>
#include "bridge_vec.hpp"
#include "readout.hpp"
#include "newton.hpp"
#include "front.hpp"
using namespace AscendC;

template<typename Out,int V>
__global__ __aicore__ __mix__(1,2) void VdnShallow(Addresses g) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    Front::Prepare<V>(g);
    auto transition=g.p[Trans], injection=g.p[Inj], prefix=g.p[Prefix], suffix=g.p[Suffix];
    auto bounds=g.p[Bounds],alpha=g.p[Alpha],intermediates=g.p[LogsTmp],logs=g.p[Logs];
    auto output=g.p[State],query=g.p[Query],y=g.p[Y],neg=g.p[NegativeMatrix],x=g.p[First],bgram=g.p[B32];
    auto inv=g.p[Inv],eye=g.p[Eye],eye2=g.p[TwoEye],workspace=g.p[Work];
    int tokens=405,frames=g.f,heads=g.h,steps=g.steps,ft=g.f;
    constexpr int E=128*128;
    for(int f=0;f<frames;f+=ft) {
        const int real=frames-f<ft?frames-f:ft;
        const int64_t off=int64_t(f)*heads*E*sizeof(float);
        JyShallowNewton::Params np{eye,neg+off,x+off,eye2,workspace,inv+off,nullptr,nullptr,
                                   (uint32_t)(real*heads),(uint32_t)steps,0.f};
        JyShallowNewton::RunNewton<32,false>(np);
        SyncAll<false>();
    }
#if defined(__DAV_CUBE__)
    {
        Front::Mark(g,7,0);
        using namespace JyShallowNewton;
        Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
        ActiveResidentGemm<32> mm(resource);
        auto aa=resource.l1Buf.template GetBufferByByte<float>(0);
        auto bb=resource.l1Buf.template GetBufferByByte<float>(MATRIX_BYTES);
        AscendC::GlobalTensor<float> A,B,C;
        A.SetGlobalBuffer((__gm__ float*)bgram);B.SetGlobalBuffer((__gm__ float*)inv);
        C.SetGlobalBuffer((__gm__ float*)injection);
        for(int j=GetBlockIdx();j<frames*heads;j+=GetBlockNum()) {
            int64_t off=int64_t(j)*E;
            mm.Load(aa,A[off]);mm.Load(bb,B[off]);mm.Multiply(aa,bb,C[off]);mm.DrainStore();
        }
        Front::Mark(g,7,1);
    }
#endif
    if constexpr(V<4) SyncAll<false>();
#if defined(__DAV_VEC__)
    {
        Front::Mark(g,8,0);
        GlobalTensor<float> A,M,T;
        A.SetGlobalBuffer((__gm__ float*)alpha);M.SetGlobalBuffer((__gm__ float*)inv);T.SetGlobalBuffer((__gm__ float*)transition);
        LocalTensor<float> ub(TPosition::VECCALC,0,2*E+128);auto sc=ub[2*E];
        for(int j=GetBlockIdx();j<frames*heads;j+=GetBlockNum()*GetSubBlockNum()) {
            int64_t off=int64_t(j)*E;
            DataCopy(ub,M[off],E);DataCopy(sc,A[j*128],128);
            PipeBarrier<PIPE_ALL>();
            for(int c=0;c<16;++c) Brcb(ub[E+c*8],sc,16,{16,128});
            PipeBarrier<PIPE_V>();Mul(ub,ub,ub[E],E);PipeBarrier<PIPE_ALL>();
            DataCopy(T[off],ub,E);PipeBarrier<PIPE_ALL>();
        }
        Front::Mark(g,8,1);
    }
#endif
    SyncAll<false>();
#if defined(__DAV_VEC__)
    constexpr int tile = 8192;
    LocalTensor<float> ub(TPosition::VECCALC,0,2*tile);
    GlobalTensor<float> src, dst;
    src.SetGlobalBuffer((__gm__ float*)injection);
    const int64_t chunks = int64_t(frames) * heads * 2;
    const uint32_t workers = GetBlockNum()*GetSubBlockNum();
    const uint32_t owner = GetBlockIdx();
    const int64_t start = chunks*owner/workers, end = chunks*(owner+1)/workers;
    Front::Mark(g,11,0);
    if constexpr(V>=7){
        GlobalTensor<float> forward,reverse;
        forward.SetGlobalBuffer((__gm__ float*)prefix + int64_t(heads)*E);
        reverse.SetGlobalBuffer((__gm__ float*)suffix);
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
        for(int64_t c=start;c<end;++c){
            const int bank=(c-start)&1;
            auto slot=ub[bank*tile];
            WaitFlag<HardEvent::MTE3_MTE2>(bank);
            DataCopy(slot,src[c*tile],tile);
            SetFlag<HardEvent::MTE2_MTE3>(bank);
            WaitFlag<HardEvent::MTE2_MTE3>(bank);
            DataCopy(forward[c*tile],slot,tile);
            DataCopy(reverse[c*tile],slot,tile);
            SetFlag<HardEvent::MTE3_MTE2>(bank);
        }
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
    } else {
    for(int pass=0;pass<2;++pass) {
        dst.SetGlobalBuffer((__gm__ float*)(pass ? suffix : prefix) + (pass ? 0 : int64_t(heads)*128*128));
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
        for (int64_t c=start;c<end;++c) {
            const int bank=(c-start)&1;
            auto slot=ub[bank*tile];
            WaitFlag<HardEvent::MTE3_MTE2>(bank);
            DataCopy(slot,src[c*tile],tile);
            SetFlag<HardEvent::MTE2_MTE3>(bank);
            WaitFlag<HardEvent::MTE2_MTE3>(bank);
            DataCopy(dst[c*tile],slot,tile);
            SetFlag<HardEvent::MTE3_MTE2>(bank);
        }
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
    }
    }
    Front::Mark(g,11,1);
#endif
    SyncAll<false>();
#if defined(__DAV_CUBE__)
    Front::Mark(g,12,0);
    VdnScanTilingData tiling{frames, heads};
    Vdn::Scan<128>((__gm__ float*)transition, (__gm__ float*)prefix, (__gm__ float*)suffix, tiling);
    Front::Mark(g,12,1);
#endif
    if constexpr(V<6) SyncAll<false>();
#if defined(__DAV_VEC__)
    {
        constexpr uint32_t D = 128;
        Front::Mark(g,13,0);
        constexpr uint32_t vectorTile = 1024;
        const unsigned worker=GetBlockIdx(), workers=GetBlockNum()*GetSubBlockNum();
        const int64_t n=int64_t(frames)*heads*D;
        GlobalTensor<float> input,clip,logv,prefixSum,bank;
        input.SetGlobalBuffer((__gm__ float*)alpha);
        clip.SetGlobalBuffer((__gm__ float*)intermediates);
        logv.SetGlobalBuffer((__gm__ float*)intermediates+n);
        prefixSum.SetGlobalBuffer((__gm__ float*)intermediates+2*n);
        bank.SetGlobalBuffer((__gm__ float*)logs);
        LocalTensor<float> local(TPosition::VECCALC,0,vectorTile*3);
        for(int pass=0;pass<2;++pass) {
            auto src=pass?clip:input;
            auto dst=pass?logv:clip;
            for(int64_t off=int64_t(worker)*vectorTile;off<n;off+=workers*vectorTile) {
                const uint32_t len=n-off<vectorTile?n-off:vectorTile;
                DataCopy(local,src[off],len);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                if(pass) Ln(local[vectorTile],local,len);
                else Maxs(local[vectorTile],local,1.e-12f,len);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopy(dst[off],local[vectorTile],len); PipeBarrier<PIPE_ALL>();
            }
            SyncAll<true>();
        }
        // Each lane retains the same group partition and FP32 addition order as the device cumsum.
        constexpr uint32_t lanes=32;
        for(unsigned j=worker;j<heads*(D/lanes);j+=workers) {
            unsigned channel=j*lanes;
            auto sum=local, partial=local[lanes], value=local[2*lanes], out=local[3*lanes];
            auto rows=local[4*lanes];
            uint32_t groups=frames<40?frames:40;
            Duplicate(sum,0.f,lanes);
            for(int g=0;g<groups;++g) {
                int size=frames/groups+(g<frames%groups);
                int first=g*(frames/groups)+(g<frames%groups?g:frames%groups);
                DataCopyParams load{(uint16_t)size,(uint16_t)(lanes/8),(uint16_t)((heads*D-lanes)/8),0};
                DataCopy(rows,logv[int64_t(first)*heads*D+channel],load);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                Duplicate(partial,0.f,lanes); PipeBarrier<PIPE_V>();
                for(int pos=0;pos<size;++pos) {
                    Add(partial,partial,rows[pos*lanes],lanes); PipeBarrier<PIPE_V>();
                    Add(rows[pos*lanes],sum,partial,lanes); PipeBarrier<PIPE_V>();
                }
                Add(sum,sum,partial,lanes);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyParams save{(uint16_t)size,(uint16_t)(lanes/8),0,(uint16_t)((heads*D-lanes)/8)};
                DataCopy(prefixSum[int64_t(first)*heads*D+channel],rows,save);
                PipeBarrier<PIPE_ALL>();
            }
        }
        SyncAll<true>();
        for(int64_t off=int64_t(worker)*vectorTile;off<n+heads*D;off+=workers*vectorTile) {
            const uint32_t len=(n+heads*D-off)<vectorTile?(n+heads*D-off):vectorTile;
            const uint32_t zeros=off>=heads*D?0:((heads*D-off)<len?(heads*D-off):len);
            if(zeros) { Duplicate(local,0.f,zeros); PipeBarrier<PIPE_ALL>(); }
            if(len>zeros) {DataCopy(local[zeros],prefixSum[off+zeros-heads*D],len-zeros); PipeBarrier<PIPE_ALL>();}
            DataCopy(bank[off],local,len);PipeBarrier<PIPE_ALL>();
        }
        SyncAll<true>();
        Front::Mark(g,13,1);
    }
#endif
    if constexpr(V>=6) SyncAll<false>();
    // One side reads the completed state panel while the other writes the next.
    const int panel=V==8?g.bridgePanel:frames;
    const int count=(frames+panel-1)/panel;
    for(int i=0;i<=count;++i){
#if defined(__DAV_VEC__)
        if(i<count){
            const int first=i*panel;
            const int num=frames-first<panel?frames-first:panel;
            VdnBridgeKernel::VdnBridgeTilingData bt{frames,heads,first,num};
            Front::Mark(g,16+2*i,0);
            VdnBridgeKernel::Gather<Out>(prefix,suffix,bounds,logs,output+int64_t(first)*heads*E*sizeof(Out),bt);
            Front::Mark(g,16+2*i,1);
        }
#elif defined(__DAV_CUBE__)
        if(i>0){
            const int first=(i-1)*panel;
            const int num=frames-first<panel?frames-first:panel;
            const int64_t matrix=int64_t(first)*heads;
            const int64_t feature=matrix*tokens*128*sizeof(Out);
            Front::Mark(g,17+2*(i-1),0);
            JyReadout::Project<Out>(query+feature,output+matrix*E*sizeof(Out),y+feature,num*heads,tokens);
            Front::Mark(g,17+2*(i-1),1);
        }
#endif
        if(i<count) SyncAll<false>();
    }
}
extern "C" void vdn_forward_pipeline_v1(void** pointers, int frames, int heads, int panel,
        int steps, int conv, int seed, aclrtStream stream) {
    Addresses g{};
    for (int i = 0; i < BufferCount; ++i) g.p[i] = (GM_ADDR)pointers[i];
    g.f = frames;
    g.h = heads;
    g.bridgePanel = panel;
    g.steps = steps;
    g.conv = conv;
    g.seed = seed;
    VdnShallow<bfloat16_t,8><<<20,nullptr,stream>>>(g);
}
