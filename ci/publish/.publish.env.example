# Copy to .publish.env (ignored by Git), chmod 600, and edit locally.
# All settings may also be supplied as process environment variables.
OBS_ACCESS_KEY=
OBS_SECRET_KEY=
# Optional: read-only token for public repository metadata / rate limits.
GITHUB_TOKEN=

# Same candidate branches on both hosts. Published formal versions are skipped.
FLA_PKG_DAILY_BRANCHES='main v26.10.0 v26.11.0'

# These are the CI image references, not CANN version declarations.
FLA_PKG_DOCKER_IMAGE=fla-npu-ci:9.1.0-910b
FLA_PKG_X86_DOCKER_IMAGE=fla-npu-ci:9.1.0-950

# Optional trusted host proxy script. Empty means use existing proxy variables.
FLA_PKG_PROXY_SCRIPT=
# http_proxy=http://127.0.0.1:<configured-port>
# https_proxy=http://127.0.0.1:<configured-port>

# Public mirror synchronization can lag behind successful OBS uploads.
FLA_PKG_PUBLIC_VERIFY_TIMEOUT=21600
FLA_PKG_PUBLIC_VERIFY_INTERVAL=300
FLA_PKG_LATEST_INTERVAL=60
