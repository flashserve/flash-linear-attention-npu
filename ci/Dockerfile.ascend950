FROM swr.cn-south-1.myhuaweicloud.com/ascendhub/cann:9.1.0-950-ubuntu22.04-py3.12

ARG PREWARM_THIRD_PARTY=true
ARG INSTALL_TORCH_NPU=true
ARG PYPI_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple
ARG TORCH_VERSION=2.12.0
# Optional overrides are complete filename / HTTPS URL / SHA256 triples.
# Empty values select the pinned CPython 3.12 wheels for the native CPU below.
ARG TORCH_WHL=
ARG TORCH_WHL_URL=
ARG TORCH_WHL_SHA256=
ARG TORCH_NPU_VERSION=2.12.0
ARG TORCH_NPU_WHL=
ARG TORCH_NPU_WHL_URL=
ARG TORCH_NPU_WHL_SHA256=
ARG TRITON_ASCEND_VERSION=3.2.1
ARG TRITON_ASCEND_INDEX_URL=https://triton-ascend.osinfra.cn/pypi/simple

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=${PYPI_INDEX_URL} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTORCH_VERSION=${TORCH_VERSION} \
    TORCH_DEVICE_BACKEND_AUTOLOAD=0 \
    CI_LOG_CLEANUP_ENABLED=true \
    CI_LOG_RETENTION_DAYS=7

SHELL ["/bin/bash", "-lc"]

RUN case "$(uname -m)" in x86_64|aarch64) ;; \
      *) echo '[CI][ERROR] A5 requires native x86_64 or aarch64 Linux.' >&2; exit 2 ;; esac && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      cmake \
      curl \
      g++ \
      gcc \
      gawk \
      git \
      git-lfs \
      make \
      ninja-build \
      openssh-client \
      patch \
      pkg-config \
      python3-dev \
      python3-pip \
      python3-setuptools \
      python3-wheel \
      valgrind && \
    rm -rf /var/lib/apt/lists/* && \
    git lfs install

COPY requirements.txt /tmp/fla-ci/requirements.txt

RUN set -e; \
    pip_retry() { \
      for attempt in $(seq 1 20); do \
        "$@" && return 0; \
        echo "[CI][pip][WARN] attempt ${attempt} failed; retrying" >&2; \
        sleep $((attempt * 2)); \
      done; \
      return 1; \
    }; \
    pip_retry python3 -m pip install 'setuptools>=70.1,<82' wheel; \
    pip_retry python3 -m pip install -r /tmp/fla-ci/requirements.txt

RUN set -euo pipefail; \
    if [[ "${INSTALL_TORCH_NPU}" == "true" ]]; then \
      python3 -c 'import sys; assert sys.version_info[:2] == (3, 12), "A5 CI requires CPython 3.12"'; \
      [[ "$TORCH_VERSION" == 2.12.0 && "$TORCH_NPU_VERSION" == 2.12.0 ]] || { \
        echo '[CI][ERROR] A5 CI requires matching torch 2.12.0 and torch_npu 2.12.0; do not reuse A2 wheels.' >&2; exit 2; }; \
      native_arch="$(uname -m)"; \
      case "$native_arch" in \
        x86_64) \
          torch_sha=5e3dc83725581fa38b7b2e45c58692e30b2a3cde19191af54b675ffcac3840a6; \
          npu_path=1b/f8/4d6a9b64ee204c0a8326e8237982fea56b9cf9d79b9ced77d2193f433e36; \
          npu_sha=acb39467b740c9dc24165b0002f3531521615d396d9386134689ce59221006c1 ;; \
        aarch64) \
          torch_sha=ce2ddb880b0813fcc91a737f08fdd973a8115a74c64ccb34e9c09a7964b4d448; \
          npu_path=36/50/c5edb71fde47d302059420b62da8737ccc71eafc526f0c31833015162af8; \
          npu_sha=6ebd04ca1facecef7618c34fb4f300b486a5f728e887f8aa5dec1154c140b888 ;; \
        *) echo "[CI][ERROR] Unsupported A5 CPU: $native_arch" >&2; exit 2 ;; \
      esac; \
      install_wheel() { \
        local prefix="$1" package="$2" expected_version="$3" expected_wheel="$4" default_url="$5" default_sha="$6"; \
        local name_var="${prefix}_WHL" url_var="${prefix}_WHL_URL" sha_var="${prefix}_WHL_SHA256"; \
        local wheel="${!name_var}" url="${!url_var}" digest="${!sha_var}"; \
        if [[ -z "$wheel$url$digest" ]]; then \
          wheel="$expected_wheel"; url="$default_url"; digest="$default_sha"; \
        fi; \
        if [[ "$wheel" != "$expected_wheel" || "$url" != https://* || ! "$digest" =~ ^[0-9a-fA-F]{64}$ ]]; then \
          echo "[CI][ERROR] ${prefix}: provide a complete filename/HTTPS URL/SHA256 triple for ${native_arch}, CPython 3.12 and version ${expected_version}." >&2; exit 2; \
        fi; \
        curl --http1.1 -fL -C - \
          --connect-timeout 15 --speed-limit 1024 --speed-time 30 --max-time 1800 \
          --retry 100 --retry-all-errors --retry-delay 1 -o "/tmp/$wheel" "$url"; \
        echo "$digest  /tmp/$wheel" | sha256sum -c -; \
        for attempt in $(seq 1 20); do \
          python3 -m pip install "/tmp/$wheel" && break; \
          [[ "$attempt" == 20 ]] && exit 1; \
          echo "[CI][pip][WARN] ${package} install attempt ${attempt} failed; retrying" >&2; \
          sleep $((attempt * 2)); \
        done; \
        rm -f "/tmp/$wheel"; \
        python3 -c 'from importlib import metadata; import sys; actual = metadata.version(sys.argv[1]); assert actual.split("+", 1)[0] == sys.argv[2], (actual, sys.argv[2]); print(sys.argv[1], actual)' "$package" "$expected_version"; \
      }; \
      install_wheel TORCH torch "$TORCH_VERSION" \
        "torch-${TORCH_VERSION}+cpu-cp312-cp312-manylinux_2_28_${native_arch}.whl" \
        "https://download-r2.pytorch.org/whl/cpu/torch-2.12.0%2Bcpu-cp312-cp312-manylinux_2_28_${native_arch}.whl" "$torch_sha"; \
      install_wheel TORCH_NPU torch-npu "$TORCH_NPU_VERSION" \
        "torch_npu-${TORCH_NPU_VERSION}-cp312-cp312-manylinux_2_28_${native_arch}.whl" \
        "https://repo.huaweicloud.com/repository/pypi/packages/${npu_path}/torch_npu-2.12.0-cp312-cp312-manylinux_2_28_${native_arch}.whl" "$npu_sha"; \
    fi

RUN set -e; \
    pip_retry() { \
      for attempt in $(seq 1 20); do \
        "$@" && return 0; \
        echo "[CI][pip][WARN] attempt ${attempt} failed; retrying" >&2; \
        sleep $((attempt * 2)); \
      done; \
      return 1; \
    }; \
    python3 -m pip uninstall -y triton || true; \
    pip_retry python3 -m pip install "triton-ascend==${TRITON_ASCEND_VERSION}" --extra-index-url="${TRITON_ASCEND_INDEX_URL}"; \
    pip_retry python3 -m pip install --target=/tmp/pybind11-target pybind11; \
    site_packages="$(python3 -c 'import site; print(site.getsitepackages()[0])')"; \
    cp -a /tmp/pybind11-target/. "$site_packages/"; \
    rm -rf /tmp/pybind11-target; \
    python3 -c 'import pybind11; print(pybind11.__file__)'; \
    python3 -c "from triton import Config; print('triton Config OK')"

RUN if [[ "${PREWARM_THIRD_PARTY}" == "true" ]]; then \
      mkdir -p /opt/fla-ci/third_party/pkg; \
      download() { \
        local url="$1"; \
        local dest="$2"; \
        if [[ -s "$dest" ]]; then return 0; fi; \
        echo "[CI][prewarm] downloading $url"; \
        if ! curl --http1.1 -fL -C - \
          --connect-timeout 15 --speed-limit 1024 --speed-time 30 --max-time 1800 \
          --retry 20 --retry-all-errors --retry-delay 1 -o "$dest" "$url"; then \
          echo "[CI][prewarm][WARN] failed to download $url"; \
          rm -f "$dest"; \
        fi; \
      }; \
      clone_at() { \
        local url="$1"; \
        local rev="$2"; \
        local dest="$3"; \
        if [[ -d "$dest/.git" ]]; then return 0; fi; \
        echo "[CI][prewarm] cloning $url"; \
        if git -c http.version=HTTP/1.1 clone "$url" "$dest" && git -C "$dest" checkout "$rev"; then \
          true; \
        else \
          echo "[CI][prewarm][WARN] failed to clone $url"; \
          rm -rf "$dest"; \
        fi; \
      }; \
      download "https://gitcode.com/cann-src-third-party/eigen/releases/download/5.0.0-h0.trunk/eigen-5.0.0.tar.gz" \
        /opt/fla-ci/third_party/pkg/eigen-5.0.0.tar.gz; \
      download "https://gitcode.com/cann-src-third-party/abseil-cpp/releases/download/20230802.1/abseil-cpp-20230802.1.tar.gz" \
        /opt/fla-ci/third_party/pkg/abseil-cpp-20230802.1.tar.gz; \
      download "https://gitcode.com/cann-src-third-party/protobuf/releases/download/v25.1/protobuf-25.1.tar.gz" \
        /opt/fla-ci/third_party/pkg/protobuf-25.1.tar.gz; \
      download "https://gitcode.com/cann-src-third-party/makeself/releases/download/release-2.5.0-patch1.0/makeself-release-2.5.0-patch1.tar.gz" \
        /opt/fla-ci/third_party/pkg/makeself-release-2.5.0-patch1.tar.gz; \
      download "https://gitcode.com/cann-src-third-party/json/releases/download/v3.11.3/include.zip" \
        /opt/fla-ci/third_party/pkg/include.zip; \
      clone_at "https://gitcode.com/cann/opbase.git" \
        c8d83f3e57a63a7375e89a2d6937452c0ae2e522 \
        /opt/fla-ci/third_party/opbase; \
      clone_at "https://gitcode.com/cann/catlass.git" \
        41bf90da655bba3c66d0acd7e00abe33960ecfd6 \
        /opt/fla-ci/third_party/catlass; \
    fi

WORKDIR /workspace/repo
